EMAIL_PORT=587

EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password

EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

EMAIL_TIMEOUT=10

DEFAULT_FROM_EMAIL=CuraMind AI <noreply@example.com>

SERVER_EMAIL=CuraMind AI <server@example.com>

