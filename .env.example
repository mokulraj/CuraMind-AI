POSTGRES_PORT=5432


REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TIMEOUT=300

TEST_REDIS_HOST=127.0.0.1
TEST_REDIS_PORT=6379
TEST_REDIS_DB=15
TEST_REDIS_PASSWORD=

CELERY_BROKER_DB=1
CELERY_RESULT_DB=2

CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False

CELERY_TASK_RESULT_EXPIRES=3600
CELERY_WORKER_CONCURRENCY=2

TEST_CELERY_BROKER_DB=11
TEST_CELERY_RESULT_DB=12

MEDIA_ROOT=media

MAX_UPLOAD_SIZE=10485760
MAX_IMAGE_UPLOAD_SIZE=10485760
MAX_REPORT_UPLOAD_SIZE=26214400

FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760

DICOM_MAX_FILE_SIZE=536870912
DICOM_READ_TIMEOUT=30
DICOM_ALLOW_FORCE_READ=False

AI_MODEL_PATH=ml_models/classification/curamind_classifier.skops

AI_MODEL_VERSION=0.1.0

AI_MODEL_SHA256=

AI_MODEL_TRUSTED_TYPES=

AUDIT_LOG_ENABLED=True
AUDIT_RETENTION_DAYS=2555
AUDIT_MAX_METADATA_SIZE=65536

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

